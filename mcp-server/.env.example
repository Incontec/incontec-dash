# URL do projeto Supabase (a mesma usada em js/config.js)
SUPABASE_URL=https://cusdjjbsvnbvspqzhkjd.supabase.co

# service_role key -- NUNCA a anon key. Este servidor roda no servidor (n8n
# fala com ele por HTTP interno), nunca no navegador, entao pode usar a
# chave que ignora RLS. Pegue em Supabase > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# organizacao_id fixo da Incontec (ver supabase/migrations/001_multi_tenant.sql).
# Usado para nao vazar dados de outro tenant se o projeto virar multi-cliente.
ORGANIZACAO_ID=00000000-0000-0000-0000-000000000001

# Porta HTTP do servidor MCP.
PORT=8787

# Token simples que o n8n deve mandar no header "Authorization: Bearer <token>".
# Gere algo aleatorio (ex: openssl rand -hex 32). Deixe em branco so em dev local.
MCP_AUTH_TOKEN=
